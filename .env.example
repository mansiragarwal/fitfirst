# Anthropic API key. SERVER-SIDE ONLY.
# Never prefix with NEXT_PUBLIC_ and never expose to the client.
# Used only by app/api/recommendations/route.ts.
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-sonnet-5 in code.
# Current model IDs (confirm at https://docs.claude.com/en/docs/about-claude/models/overview):
#   claude-sonnet-5             balanced speed + intelligence (default)
#   claude-opus-5               strongest output, higher cost
#   claude-haiku-4-5-20251001   fastest / lowest cost
#   claude-fable-5              next-gen long-running agents
# ANTHROPIC_MODEL=claude-sonnet-5
